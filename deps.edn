{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        clj-python/libpython-clj {:mvn/version "2.026"}

        ;; hive-addon: the IAddon contract this addon implements. Depending on
        ;; the contract lib rather than on a host namespace is what lets any
        ;; host, hive-mcp or not, mount this jar.
        ;; Floor 0.3.12: first release carrying both companion contracts this
        ;; addon reifies, hive-addon.terminal/ITerminalAddon and
        ;; hive-addon.vessel/IVessel.
        io.github.hive-agi/hive-addon
        {:mvn/version "0.3.12"}

        ;; hive-dsl — Result monad, rescue/guard DSL, ADTs
        io.github.hive-agi/hive-dsl
        {:mvn/version "0.5.21"}

        ;; hive-di — typed config DI (env/file/coalesce sources)
        io.github.hive-agi/hive-di
        {:mvn/version "0.4.8"}

        ;; hive-events — event system for pane lifecycle
        io.github.hive-agi/hive-events
        {:mvn/version "0.5.9"}}
 :aliases
 {
  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
          :ns-default hive-build.api}
:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test
                      {:mvn/version "0.3.17"}}}}}
