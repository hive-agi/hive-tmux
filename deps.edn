{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        clj-python/libpython-clj {:mvn/version "2.026"}

        ;; hive-dsl — Result monad, rescue/guard DSL, ADTs
        io.github.hive-agi/hive-dsl
        {:mvn/version "0.5.7"}

        ;; hive-di — typed config DI (env/file/coalesce sources)
        io.github.hive-agi/hive-di
        {:mvn/version "0.3.2"}

        ;; hive-events — event system for pane lifecycle
        io.github.hive-agi/hive-events
        {:mvn/version "0.5.6"}}
 :aliases
 {
  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}
:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.hive-agi/hive-test
                      {:mvn/version "0.3.10"}}}}}
